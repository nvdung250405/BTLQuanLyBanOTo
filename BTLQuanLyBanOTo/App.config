<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<connectionStrings>
		<!-- Kết nối SQL Server cục bộ qua Windows Authentication (Mặc định cho Visual Studio / SSMS) -->
		<add name="myConnectionString"
             connectionString="Data Source=.;Initial Catalog=QuanLyCuaHangOto;Integrated Security=True"
             providerName="System.Data.SqlClient" />

		<!-- Kết nối SQL Server nếu dùng tài khoản sa (ví dụ chạy trên Docker):
		<add name="myConnectionString"
             connectionString="Data Source=localhost,1433;Initial Catalog=QuanLyCuaHangOto;User Id=sa;Password=QuanLyOTo@2026;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
		-->
	</connectionStrings>
</configuration>